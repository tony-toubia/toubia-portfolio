# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/*
# ...but the extracted 990 corpus is checked in: it is public federal data,
# it is what populates a fresh WRTT database, and re-extracting it means
# ~40 minutes of IRS bundle downloads for a byte-identical result.
#
# Two forms, each earning its place:
#
# .gz is what ingest-990.mjs --from replays locally.
!data/990-full.ndjson.gz
# The parts are what wrtt.load_from_url fetches. Postgres pulls them from
# raw.githubusercontent rather than having 11MB of officer rosters relayed
# through a tool call, so they must be plain text and reachable by URL -
# and raw.githubusercontent 404s a 12MB file while serving ~4MB parts fine.
# One part per load_from_url call. Git zlib-compresses blobs, so checking in
# plain text costs the repo about what the .gz does.
!data/990-full.part1.ndjson
!data/990-full.part2.ndjson
!data/990-full.part3.ndjson
# The single uncompressed data/990-full.ndjson is deliberately NOT here. It is
# byte-identical to the three parts concatenated, and it is the one form
# nothing can use: too big for raw.githubusercontent, redundant with the .gz
# locally. `cat data/990-full.part*.ndjson` reproduces it if you want it, and
# ingest-990.mjs --out writes it fresh.
!data/990n.ndjson.gz
# Org-site scan: the findings are the durable artifact (the crawl is slow and
# the web moves under it), and a plain file is fetchable by URL for loading.
!data/org-scan.ndjson
!data/org-scan-targets.json
# FEC employer directory: 11k people distilled from a 4GB federal download, so
# the extract is worth keeping even though re-deriving it is only two minutes.
# Employer and occupation only - no committee, amount, party or memo field is
# extracted, so this is an employer directory and not a contribution history.
!data/fec-employers.ndjson
!data/fec-employers-prior.ndjson
# Organization street addresses from the IRS Business Master File, joined by
# EIN. Public org data - but a small nonprofit is often registered at a board
# member's house, so premises_type flags the ones that look residential rather
# than flattening them into "org data".
!data/bmf-org-addresses.ndjson

.cache/
