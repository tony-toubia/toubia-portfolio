# ── WRTT Index ────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → Session pooler.
# Swap [YOUR-PASSWORD] for the database password (Settings → Database → Reset if unknown).
WRTT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# REQUIRED for the console to be reachable at all. There is no default and no
# fallback: with this unset, every password is rejected and /wrtt is closed,
# including locally. That is deliberate - this repository is public, so a
# fallback in the code would be a published password. Set it here (.env.local
# is gitignored) and in Vercel for production and preview.
WRTT_GATE_PASSWORD=

# Second, stronger lock over the scoring levers, the activity log and the CSV
# export. Already fails closed; without it those stay read-only.
WRTT_ADMIN_TOKEN=

# Only needed once web-roster extraction is switched on. The 990 pipeline is
# deterministic and needs no key.
ANTHROPIC_API_KEY=

# Optional source keys. Neither is required for the 990 backbone.
RUNSIGNUP_API_KEY=
EVENTBRITE_TOKEN=
